# Committed local-development defaults only. These credentials are public and
# intentionally weak; never reuse them or this file's values in production.
# Copy to .env for local use. Keep real credentials out of this file.

APP_ENV=local
APP_NAME=recipe-api
FRONTEND_URL=http://localhost:5173
# Convenience URL; Docker Compose does not consume this variable.
API_URL=http://localhost:8000

# Database
POSTGRES_DB=recipe_app
POSTGRES_USER=app
# Local-only password shared by Postgres and the API/worker connection URL.
POSTGRES_PASSWORD=app_password
DATABASE_URL=postgresql+psycopg://app:app_password@postgres:5432/recipe_app

# Object storage (LocalStack S3)
S3_ENDPOINT=http://localstack:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
# Set this in your ignored .env from your LocalStack workspace. Never commit the token.
# LocalStack requires an auth token linked to an active license.
# LOCALSTACK_AUTH_TOKEN=

# LLM provider
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Mailpit
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
# Convenience URL; Docker Compose does not consume this variable.
MAILPIT_WEB_UI=http://localhost:8025

# Frontend
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Recipe App
